# Public IP or DNS name clients use to reach this VPN server.
# Example: 74.208.54.132 or vpn.example.com
WG_HOST=YOUR_PUBLIC_IP_OR_DNS

# WireGuard UDP port (open in firewall / cloud security group)
WG_PORT=51820

# Web UI TCP port (restrict this; prefer reverse proxy + HTTPS)
UI_PORT=51821

# true = allow HTTP UI without TLS (OK for first setup / private networks only)
INSECURE=true

# Optional deploy defaults for scripts/deploy-vps.sh
# VPS_HOST=74.208.54.132
# VPS_USER=root
# VPS_DEPLOY_PATH=/opt/wireguard
