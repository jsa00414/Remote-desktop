# Public IP or DNS clients use for the VPN endpoint.
WG_HOST=74.208.54.132

# WireGuard tunnel (internet) — UDP
WG_PORT=5000

# VPN controls website — TCP
UI_PORT=5001

# Allow HTTP UI without TLS (set false behind Caddy/HTTPS)
INSECURE=true

# First-boot admin (only applied on empty volume)
INIT_ENABLED=true
INIT_USERNAME=admin
INIT_PASSWORD=ChangeMe-WireGuard-5001
INIT_DNS=1.1.1.1,8.8.8.8

# Deploy defaults for scripts/deploy-vps.sh
VPS_HOST=74.208.54.132
VPS_USER=root
VPS_DEPLOY_PATH=/opt/wireguard
