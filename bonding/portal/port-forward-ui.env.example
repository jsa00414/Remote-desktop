# Copy to /opt/wireguard/port-forward-ui.env on the VPS. Do not commit the real file.

PF_HOST=0.0.0.0
PF_PORT=5002
PF_USER=admin
PF_PASS=CHANGE_ME

ROUTER_HOST=10.8.0.3
ROUTER_HOSTS=10.8.0.3,192.168.8.1
ROUTER_USER=root
ROUTER_PASS_B64=CHANGE_ME_BASE64
ROUTER_CONF=/etc/config/port_forward

FORWARDS_CONF=/opt/wireguard/scripts/forwards.conf
APPLY_SCRIPT=/opt/wireguard/scripts/apply-lan-forwards.sh
CADDYFILE_PATH=
CADDY_CONTAINER=
HOOKUPS_JSON=/opt/wireguard/port-forward-ui/hookups.json
VPS_PUBLIC_IP=YOUR.VPS.IP
DOCKER_HOST_GW=172.18.0.1
PANEL_TITLE=ServerManager
PANEL_TAGLINE=Sign in to manage VPS forwards, GL.iNet, domains, and firewall.

CF_API_TOKEN=
CF_ZONE_ID=
CF_ZONE_NAME=
CF_PROXIED=false

WANBOND_PORT=8443
WANBOND_PORTS=8443,51820,4410
WANBOND_SCRIPT=/opt/wireguard/scripts/wanbond.py
WANBOND_KEY_FILE=/opt/wireguard/wanbond.key
